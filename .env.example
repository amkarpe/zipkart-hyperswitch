# Copy to .env and fill in. Never commit .env.

# ── Hyperswitch ─────────────────────────────────────────
HYPERSWITCH_BASE_URL=https://sandbox.hyperswitch.io
# secret, server only
HYPERSWITCH_API_KEY=snd_xxxxxxxxxxxxxxxx
# public, sent to the browser
HYPERSWITCH_PUBLISHABLE_KEY=pk_snd_xxxxxxxxxxxxxxxx
HYPERSWITCH_PROFILE_ID=pro_xxxxxxxxxxxxxxxx
# payment_response_hash_key from the Hyperswitch dashboard (webhook signature)
HYPERSWITCH_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# ── Database ────────────────────────────────────────────
# Neon pooled connection string (host contains "-pooler")
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── App ─────────────────────────────────────────────────
# "production" on Render
APP_ENV=development
# your Render URL once deployed
APP_BASE_URL=http://localhost:8000
STORE_CONSOLE_PASSWORD=change-me

# ── Business settings ───────────────────────────────────
CURRENCY=USD
WEIGHT_BUFFER_PERCENT=15
SUBSTITUTION_TIMEOUT_SECONDS=60
RECONCILE_AFTER_MINUTES=5

# ── Reconciliation sweep (optional; defaults shown) ─────
SWEEP_INTERVAL_SECONDS=180
# Authorize.net Transaction Cut-Off Time (Account > Settings). Refunds for captures
# made before the last cut-off are retried by the sweep.
SETTLEMENT_CUTOFF=15:00
SETTLEMENT_TIMEZONE=America/Los_Angeles
